{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/icons/**",
              "components/kit/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Sans|Space Grotesk|IBM Plex Sans|Inter|Figtree))/i]",
        "message": "Font not provided by the design system. Available: Instrument Sans, Space Grotesk, IBM Plex Sans, Inter, Figtree."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|icon1|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: className, style, text1, icon1."
      },
      {
        "selector": "JSXOpeningElement[name.name='BASEInputField'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|text1|text2|text3|icon2|key|ref|className|style|children)$/]",
        "message": "<BASEInputField> doesn't accept that prop. Declared props: className, style, text1, text2, text3, icon2."
